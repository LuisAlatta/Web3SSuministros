---
import { site, whatsapps, waLink, socials } from "../data/site";
import { productosCategorias } from "../data/content";
import Icon from "../components/Icon.astro";

const year = new Date().getFullYear();
const hasSocial = socials.some((s) => s.url !== "#");
---

<footer class="ft on-dark">
  <div class="ft-hazard" aria-hidden="true"></div>

  <div class="container ft-inner">
    <!-- Identidad -->
    <div class="ft-brand">
      <span class="ft-kicker">Catálogo</span>
      <p class="ft-banner-title">Suministros Industriales</p>
      <p class="ft-tagline">{site.tagline}.</p>
      {
        hasSocial && (
          <div class="ft-social">
            {socials.map((s) => (
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.label}>
                <Icon name={s.icon} size={18} />
              </a>
            ))}
          </div>
        )
      }
    </div>

    <!-- Accesos por categoría -->
    <ul class="ft-cats">
      {
        productosCategorias.map((c) => (
          <li>
            <a href={`/productos?cat=${c.key}`} aria-label={c.label}>
              <span class="ft-cat-badge">
                <Icon name={c.icon} size={26} />
              </span>
              <span class="ft-cat-label">{c.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Contacto -->
    <div class="ft-contact">
      <h4>Contacto</h4>
      <ul>
        <li>
          <a href={site.website.url} target="_blank" rel="noopener">
            <Icon name="globe" size={17} /><span>{site.website.display}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" size={17} /><span>{site.email}</span>
          </a>
        </li>
        {
          whatsapps.map((w) => (
            <li>
              <a href={waLink(w.intl)} target="_blank" rel="noopener">
                <Icon name="whatsapp" size={17} />
                <span>{w.label}: {w.display}</span>
              </a>
            </li>
          ))
        }
        <li class="ft-addr">
          <Icon name="pin" size={17} /><span>{site.address.full}</span>
        </li>
        <li class="ft-hours">
          <Icon name="star" size={17} /><span>{site.hours}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="ft-bottom">
    <div class="container ft-bottom-inner">
      <p>© {year} {site.legalName} · RUC {site.ruc}</p>
      <p class="ft-made">Arequipa, Perú</p>
    </div>
  </div>
</footer>

<style>
  .ft {
    position: relative;
    background: linear-gradient(160deg, #12161d, #05070a 72%);
    border-top: 2px solid var(--amber);
    overflow: hidden;
    isolation: isolate;
  }
  .ft::after {
    /* halo atmosférico ámbar */
    content: "";
    position: absolute;
    top: -30%;
    right: -8%;
    width: min(620px, 60%);
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      rgba(var(--amber-rgb), 0.14),
      transparent 62%
    );
    z-index: -1;
    pointer-events: none;
  }
  .ft-hazard {
    position: absolute;
    inset: 0 auto 0 0;
    width: clamp(12px, 1.6vw, 18px);
    background: var(--hazard);
    opacity: 0.92;
    z-index: 1;
  }

  /* — Banda principal: identidad · categorías · contacto — */
  .ft-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    padding-block: clamp(2.4rem, 4.5vw, 3.4rem);
    padding-left: clamp(2rem, 5vw, 3.4rem);
  }

  .ft-kicker {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--amber);
    margin-bottom: 0.55rem;
  }
  .ft-banner-title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.02;
    font-size: clamp(1.55rem, 1rem + 2.8vw, 3rem);
    color: #fff;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.55);
  }
  .ft-cats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.1rem, 3vw, 1.6rem) 0.6rem;
  }
  .ft-cats a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    text-align: center;
    color: var(--text-dim);
    transition: color var(--dur) var(--ease-out);
  }
  .ft-cat-badge {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(60px, 12vw, 78px);
    height: clamp(60px, 12vw, 78px);
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    background: linear-gradient(
      160deg,
      rgba(255, 255, 255, 0.05),
      rgba(255, 255, 255, 0)
    );
    color: #fff;
    transition: border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .ft-cat-label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.25;
    max-width: 12ch;
  }
  .ft-cats a:hover .ft-cat-badge {
    border-color: var(--amber);
    background: var(--amber-tint);
    color: var(--amber);
    transform: translateY(-4px);
    box-shadow: 0 10px 24px -12px rgba(var(--amber-rgb), 0.6);
  }
  .ft-cats a:hover {
    color: #fff;
  }
  .ft-cats a:focus-visible .ft-cat-badge {
    outline: none;
    box-shadow: 0 0 0 3px var(--amber-tint);
    border-color: var(--amber);
  }

  /* Marca */
  .ft-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }
  .ft-brand .ft-kicker {
    margin-bottom: 0;
  }
  .ft-brand .ft-banner-title {
    margin-bottom: 0.2rem;
  }
  .ft-tagline {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 34ch;
  }
  .ft-social {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .ft-social a {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .ft-social a:hover {
    color: var(--on-amber);
    background: var(--amber);
    border-color: var(--amber);
    transform: translateY(-3px);
  }

  /* Contacto con íconos */
  .ft-contact h4 {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text);
    margin-bottom: 1.1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
  }
  .ft-contact ul {
    display: grid;
    gap: 0.7rem;
  }
  .ft-contact li {
    display: block;
  }
  .ft-contact a,
  .ft-contact .ft-addr,
  .ft-contact .ft-hours {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .ft-contact :global(svg) {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--amber);
  }
  .ft-contact a:hover {
    color: var(--amber);
  }
  .ft-addr span,
  .ft-hours span {
    max-width: 30ch;
  }

  /* — Barra inferior — */
  .ft-bottom {
    border-top: 1px solid var(--line);
  }
  .ft-bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding-block: 1.1rem 1.4rem;
    color: var(--text-dim);
    font-size: 0.82rem;
  }
  .ft-made {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    letter-spacing: 0.04em;
  }
  .ft-made::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 8px rgba(var(--amber-rgb), 0.8);
  }

  @media (min-width: 560px) {
    .ft-cats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 960px) {
    .ft-inner {
      grid-template-columns: minmax(0, 15rem) 1fr minmax(0, 16rem);
      align-items: center;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    .ft-cats {
      grid-template-columns: repeat(7, 1fr);
      gap: clamp(0.5rem, 1vw, 0.9rem);
    }
    .ft-cat-badge {
      width: clamp(56px, 4.6vw, 72px);
      height: clamp(56px, 4.6vw, 72px);
    }
    .ft-contact {
      justify-self: end;
    }
  }
</style>
